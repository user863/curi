","poland","black-background","close-up","silesia","texture","stag-horn"],"tone":"sky","quality":1.174},"sw":"#c3c3c3","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1916.1782/1916.1782_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150648":{"n":150648,"cl":56,"id":"cma-100136","type":"image","cat":"visual","title":"Wheel-Lock Rifle","creator":"Unknown maker","date":"1618","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1919.65"},"rights":{"license":"CC0"},"editorial":{"note":"The artisan who made this rifle used brass, bone, horn, and ivory to create decorative elements like animals involved in the hunt, fruits, and other details.","noteSource":"source","room":"objects","tags":["17th-century","photograph","design","brass","germany","arms-and-armor","steel","close-up","vintage","horn-and-ivory"],"tone":"mauve","quality":1.174},"sw":"#d1d2d1","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1919.65/1919.65_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150663":{"n":150663,"cl":56,"id":"cma-96787","type":"image","cat":"visual","title":"Flintlock Pistol (1 of 2)","creator":"Unknown maker","date":"early 1700s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1916.50.1"},"rights":{"license":"CC0"},"editorial":{"note":"The flintlock ignition system was developed in the 1600s and remained the dominant system until the early 1800s.","noteSource":"source","room":"objects","tags":["18th-century","photograph","design","li-ge","arms-and-armor","gilt-brass-mounts","walnut-burl-stock","franco-flemish"],"tone":"sky","quality":1.174},"sw":"#212020","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1916.50.1/1916.50.1_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150687":{"n":150687,"cl":56,"id":"cma-96786","type":"image","cat":"visual","title":"Pair of Flintlock Pistols","creator":"Unknown maker","date":"early 1700s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1916.50"},"rights":{"license":"CC0"},"editorial":{"note":"The flintlock ignition system was developed in the 1600s and remained the dominant system until the early 1800s.","noteSource":"source","room":"objects","tags":["18th-century","photograph","li-ge","arms-and-armor","black-background","gilt-brass-mounts","walnut-burl-stock","franco-flemish"],"tone":"sky","quality":1.174},"sw":"#533f33","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1916.50/1916.50_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150693":{"n":150693,"cl":56,"id":"cma-96808","type":"image","cat":"visual","title":"Pair of Flintlock Pistols","creator":"Unknown maker","date":"c. 1670","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1916.52"},"rights":{"license":"CC0"},"editorial":{"note":"This type of pistol fired only once before needing to be reloaded, so they were often produced in matched pairs. Even the trigger is decorated on these beautifully ornate weapons.","noteSource":"source","room":"objects","tags":["17th-century","photograph","italy","design","arms-and-armor","steel","brescia","black-background"],"tone":"paper","quality":1.174},"sw":"#80807f","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1916.52/1916.52_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150844":{"n":150844,"cl":56,"id":"cma-96768","type":"image","cat":"visual","title":"Flintlock Pistol","creator":"Unknown maker","date":"1788","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1916.49"},"rights":{"license":"CC0"},"editorial":{"note":"With its embellished steel and inlaid bone handle, this fine pistol was a gentlemen's weapon. This is the type of gun gentlemen used in duels, counting out ten paces then turning and firing their pistols.","noteSource":"source","room":"objects","tags":["18th-century","photograph","italy","design","arms-and-armor","steel","brescia","black-background","texture"],"tone":"paper","quality":1.174},"sw":"#0e0e0e","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1916.49/1916.49_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150919":{"n":150919,"cl":56,"id":"cma-99068","type":"image","cat":"visual","title":"Snaphance Pistol","creator":"Unknown maker","date":"1600s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1918.68"},"rights":{"license":"CC0"},"editorial":{"note":"A snaphance pistol is a type of barrel-loading, flintlock gun. The snaphance is a spring-lock mechanism used for discharging a flint. This innovation greatly improved the efficiency of getting a shot off.","noteSource":"source","room":"objects","tags":["17th-century","photograph","design","spain","arms-and-armor","steel","close-up","artifact","texture","ripoll"],"tone":"mauve","quality":1.174},"sw":"#707070","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1918.68/1918.68_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"150935":{"n":150935,"cl":56,"id":"cma-110070","type":"image","cat":"visual","title":"Pellet Crossbow for a Child","creator":"Unknown maker","date":"c. 1600–1650","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1928.671"},"rights":{"license":"CC0"},"editorial":{"note":"This crossbow, made for the use of a small child, was designed to throw small stones or pellets. The bow string is an accurate replacement.","noteSource":"source","room":"objects","tags":["17th-century","photograp
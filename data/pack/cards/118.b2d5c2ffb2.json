 earlobes.","noteSource":"source","room":"interiors","tags":["medieval","sculpture","sandstone","cambodian-art","southern-cambodia","takeo-province"],"tone":"sky","quality":1.25},"sw":"#898686","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1973.106/1973.106_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2645":{"n":2645,"cl":118,"id":"cma-125229","type":"image","cat":"visual","title":"Square Ornament from a Tunic","creator":"Unknown maker","date":"700s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1947.192"},"rights":{"license":"CC0"},"editorial":{"note":"Seen as a prized decoration, designs like this were often cut out of older textiles and stitched onto unisex linen tunics.","noteSource":"source","room":"interiors","tags":["medieval","textile","silk","t-islamic","egypt-or-syria"],"tone":"mauve","quality":1.25},"sw":"#c38c70","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1947.192/1947.192_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2649":{"n":2649,"cl":118,"id":"cma-157341","type":"image","cat":"visual","title":"Mat Weight in the Form of a Bear","creator":"Unknown maker","date":"202 BCE–9 CE","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1994.203"},"rights":{"license":"CC0"},"editorial":{"note":"Bear imagery, which symbolized heroic power, was particularly popular during the Han dynasty.","noteSource":"source","room":"interiors","tags":["ancient","sculpture","china","gilt-bronze"],"tone":"mauve","quality":1.25},"sw":"#acacac","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1994.203/1994.203_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2651":{"n":2651,"cl":118,"id":"cma-147003","type":"image","cat":"visual","title":"Footed Platter with Design of Mythical Beas
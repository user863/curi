":["medieval","sculpture","glazed-earthenware","tang-dynasty-618-907","north-china"],"tone":"paper","quality":1.25},"sw":"#646362","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1931.450/1931.450_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2667":{"n":2667,"cl":118,"id":"cma-121207","type":"image","cat":"visual","title":"Textile Ornaments(?): Pair of Phoenixes","creator":"Unknown maker","date":"c. 700s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1942.1083"},"rights":{"license":"CC0"},"editorial":{"note":"These two phoenix birds made of thin gold foil have tiny holes all along their edges, suggesting that they were sewn on textiles.","noteSource":"source","room":"interiors","tags":["medieval","china","metalwork","tang-dynasty-618-907"],"tone":"mauve","quality":1.25},"sw":"#242424","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1942.1083/1942.1083_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2677":{"n":2677,"cl":118,"id":"cma-150036","type":"image","cat":"visual","title":"Ascetic Holding a Skull","creator":"Unknown maker","date":"c. 500 CE","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1980.25"},"rights":{"license":"CC0"},"editorial":{"note":"This grimacing figure has a potbelly protruding between the hem of his short jacket and fringed skirt ( dhoti ).","noteSource":"source","room":"interiors","tags":["ancient","sculpture","china","gilt-bronze"],"tone":"sky","quality":1.25},"sw":"#363633","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1980.25/1980.25_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2679":{"n":2679,"cl":118,"id":"cma-154216","type":"image","cat":"visual","title":"Standing Amitabha","creator":"Unknown maker","date":"800s","source":{"institution":
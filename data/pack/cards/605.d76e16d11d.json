n","date":"","source":{"institution":"National Museum of Romanian History via Europeana","work":null,"url":"https://www.europeana.eu/item/2048047/Clasate_238d71c552934aa6909d93bc631d0979"},"rights":{"license":"CC-BY-SA"},"editorial":{"note":"Gemă reprezentând frontal pe silenul Marsyas stând pe o stâncă cu piciorul drept îndoit din genunchi și cu stângul întins și cântând din flautul dublu. În jurul mijlocului are înfășurată o hlamidă cu un capăt care flutură la spate.","noteSource":"source","room":"objects","tags":["photograph","europeana","sculpture","art","archaeology","ancient-rome","carnelian","figure","carving","gemstone","background","artifact","man","new"],"tone":"ink","quality":1.119},"media":{"kind":"image","url":"https://resource.culturalia.ro/imagini-clasate/imagini33/c42d4779255c477498cfd8fc956016f6.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"67031":{"n":67031,"cl":605,"id":"eu-2048047_Clasate_262f563cfe8f443dba930a07d4953144","type":"image","cat":"visual","title":"Relief votiv","creator":"Unknown","date":"","source":{"institution":"National Museum of Romanian History via Europeana","work":null,"url":"https://www.europeana.eu/item/2048047/Clasate_262f563cfe8f443dba930a07d4953144"},"rights":{"license":"CC-BY-SA"},"editorial":{"note":"Plăcuța provine din zona Aradului. Relieful este în formă de ediculă, rotunjit la partea superioară și mărginit de un chenar, mai lat sus, și decorat lateral cu câte un șarpe care se unduiește.","noteSource":"source","room":"objects","tags":["photograph","europeana","sculpture","art","horse","archaeology","ancient-rome","marble","figure","carving","marble-rock","artifact","texture","new"],"tone":"sky","quality":1.119},"media":{"kind":"image","url":"https://resource.culturalia.ro/imagini-clasate/imagini51/5223eaa895e84753ba562a51e0d2d52a.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"67043":{"n":67043,"cl":605,"id":"eu-2048047_Clasate_29a2736ad4444391a688b47f217
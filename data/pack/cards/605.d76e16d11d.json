"visual","title":"Relief votiv","creator":"Unknown","date":"","source":{"institution":"National Museum of Romanian History via Europeana","work":null,"url":"https://www.europeana.eu/item/2048047/Clasate_2a5b4ae66665461fa2ad02ea50f9ac51"},"rights":{"license":"CC-BY-SA"},"editorial":{"note":"Placă, de formă dreptunghiulară, închinată zeilor vindecători. În centru este reprezentat Aesculapius cu bustul nud, în mâna dreaptă ține un baston pe care se încolăcește un șarpe.","noteSource":"source","room":"objects","tags":["europeana","sculpture","art","archaeology","ancient-rome","figure","carving","polishing","new"],"tone":"paper","quality":1.119},"media":{"kind":"image","url":"https://resource.culturalia.ro/imagini-clasate/imagini31/74623177d6e347e89b3d00b3a6a745c3.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"67051":{"n":67051,"cl":605,"id":"eu-2048047_Clasate_2b0390640e2d4409aae38ab6d8df04e3","type":"image","cat":"visual","title":"Faustina","creator":"Unknown","date":"","source":{"institution":"National Museum of Romanian History via Europeana","work":null,"url":"https://www.europeana.eu/item/2048047/Clasate_2b0390640e2d4409aae38ab6d8df04e3"},"rights":{"license":"CC-BY-SA"},"editorial":{"note":"Cap de statuie reprezentând-o pe Faustina junior. Portret idealizat. Părul pieptănat cu cărare la mijloc, șuvițe în formă de melcișori pe frunte, coc la ceafă. Ochii au irisul și pupila marcată. Trăsături fine.","noteSource":"source","room":"objects","tags":["photograph","europeana","sculpture","art","statues","archaeology","ancient-rome","marble","bust","marble-rock","artifact","curly-hair","texture","new"],"tone":"paper","quality":1.119},"media":{"kind":"image","url":"https://resource.culturalia.ro/imagini-clasate/imagini31/c5c8b03896754c3fbf973a4761ff1c25.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"67066":{"n":67066,"cl":605,"id":"eu-2048047_Clasate_2f2014bd8e6c4322908fb90646f0ffab","type":"image","cat":"visual"
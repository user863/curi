-quartz"],"tone":"sky","quality":1.29},"sw":"#b9b4b7","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1966.450/1966.450_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2225":{"n":2225,"cl":185,"id":"cma-142761","type":"image","cat":"visual","title":"Pill or Snuff Box","creator":"Feodor Ivanovich Rückert","date":"1906–16","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1966.466"},"rights":{"license":"CC0"},"editorial":{"note":"Around 1900, ladies often carried little boxes for medicines, a pinch of snuff, or cosmetic patches for the face.","noteSource":"source","room":"interiors","tags":["20th-century","decorative-arts","miscellaneous","russia","st-petersburg"],"tone":"paper","quality":1.29},"sw":"#a6a5b1","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1966.466/1966.466_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2238":{"n":2238,"cl":185,"id":"cma-142759","type":"image","cat":"visual","title":"Lacquer Box","creator":"House of Fabergé","date":"c. 1890","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1966.464"},"rights":{"license":"CC0"},"editorial":{"note":"Piotr Lukutin’s workshop employed over 50 skilled painters as well as acted as a school for training apprentices.","noteSource":"source","room":"interiors","tags":["19th-century","gold","miscellaneous","lacquer","diamonds","papier-m-ch"],"tone":"sky","quality":1.29},"sw":"#a3a2a1","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1966.464/1966.464_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2240":{"n":2240,"cl":185,"id":"cma-142777","type":"image","cat":"visual","title":"Miniature Teapot","creator":"Mikhail Evlampievich Perkhin","date":"1886–96","source":{"institution":"Cleveland Museum of Art, Open Access","work":nu
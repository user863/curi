tic spherical knob of wood or head atop a cylindrical shaft.","noteSource":"source","room":"interiors","tags":["19th-century","wood","arms-and-armor","african-art","africa","southern-africa"],"tone":"paper","quality":1.25},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/2010.203/2010.203_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2880":{"n":2880,"cl":38,"id":"cma-148152","type":"image","cat":"visual","title":"Mask (Omono or Tana Wurum Bogoro)","creator":"Unknown maker","date":"early 1900s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1975.151"},"rights":{"license":"CC0"},"editorial":{"note":"The long-armed figure at the top of this mask is omono , a white-bellied monkey.","noteSource":"source","room":"interiors","tags":["20th-century","mask","african-art","africa","west-africa","wood-and-paint"],"tone":"mauve","quality":1.25},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1975.151/1975.151_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2887":{"n":2887,"cl":38,"id":"cma-169324","type":"image","cat":"visual","title":"Helmet Mask","creator":"Unknown maker","date":"possibly early to mid-1900s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/2011.196"},"rights":{"license":"CC0"},"editorial":{"note":"This mask likely depicts a hyena, an animal known for its intellect and knowledge of the bush.","noteSource":"source","room":"interiors","tags":["20th-century","mask","african-art","africa","west-africa","mali"],"tone":"sky","quality":1.25},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/2011.196/2011.196_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2915":{"n":2915,"cl":38,"id":"cma-168415","type":"image","cat":"visual","title":"Headrest","creator":"Unknown maker","date":
73.221"},"rights":{"license":"CC0"},"editorial":{"note":"The interlacing pattern on the base of this sculpture can be seen in Benin Kingdom works in materials from wood to ivory to metal.","noteSource":"source","room":"interiors","tags":["20th-century","sculpture","wood","african-art","nigeria","benin-kingdom"],"tone":"sky","quality":1.25},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1973.221/1973.221_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2749":{"n":2749,"cl":38,"id":"cma-311742","type":"image","cat":"visual","title":"Bow Stand","creator":"Unknown maker","date":"1800s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/2018.27"},"rights":{"license":"CC0"},"editorial":{"note":"The shape of this wooden bow stand is based on a more practical version in metal used by hunters.","noteSource":"source","room":"interiors","tags":["19th-century","sculpture","african-art","central-africa","africa","luba-style-carver"],"tone":"paper","quality":1.25},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/2018.27/2018.27_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2754":{"n":2754,"cl":38,"id":"cma-163793","type":"image","cat":"visual","title":"Sculptural Element from a Reliquary Ensemble (mbulu ngulu)","creator":"Unknown maker","date":"probably 1800s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/2005.2"},"rights":{"license":"CC0"},"editorial":{"note":"The diamond-shaped \"body\" of this sculpture was originally pushed into a container of ancestral relics (bones) up to its \"shoulders.\" Metal covers only areas of the wood that were left visible.","noteSource":"source","room":"interiors","tags":["19th-century","sculpture","wood","african-art","copper-alloy","and-iron"],"tone":"sky","quality":1.25},"media":{"kind":"image","url":"https:/
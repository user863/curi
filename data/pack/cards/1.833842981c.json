":"paper","quality":1.29},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1968.30/1968.30_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2316":{"n":2316,"cl":1,"id":"cma-148725","type":"image","cat":"visual","title":"Box","creator":"Thomas Heming","date":"1771","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1976.17"},"rights":{"license":"CC0"},"editorial":{"note":"This small box likely held jewelry and may have been accompanied by a mirror, scent bottles, brushes, combs, candlesticks, and small covered bowls on a wealthy woman’s dressing table.","noteSource":"source","room":"interiors","tags":["18th-century","england","silver","decorative-arts","silver-gilt","london"],"tone":"mauve","quality":1.29},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1976.17/1976.17_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2319":{"n":2319,"cl":1,"id":"cma-122925","type":"image","cat":"visual","title":"Wine Ewer","creator":"Paul Storr","date":"1815","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1943.181"},"rights":{"license":"CC0"},"editorial":{"note":"The vine-leaf border along the top of this ewer was inspired by Roman silver from antiquity and popularized by Paul Storr in the 1800s.","noteSource":"source","room":"interiors","tags":["19th-century","england","silver","decorative-arts","silver-gilt","london"],"tone":"paper","quality":1.29},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1943.181/1943.181_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2361":{"n":2361,"cl":1,"id":"cma-149950","type":"image","cat":"visual","title":"Ewer (aiguière)","creator":"Jean Baptiste Claude Odiot","date":"c. 1817","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1980.183"},"rights":{"license":"CC0"},"editorial":{"note":"The coat of arms on the foot of this ewer belongs to the count Alfred de la Chapelle who owned this silver dinner service during the second half of the 19th century.","noteSource":"source","room":"interiors","tags":["19th-century","france","silver","decorative-arts","silver-gilt"],"tone":"sky","quality":1.29},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1980.183/1980.183_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2363":{"n":2363,"cl":1,"id":"cma-160037","type":"image","cat":"visual","title":"Nautilus Reading Lamp","creator":"Tiffany Glass & Decorating Company","date":"c. 1899–1902","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1997.298"},"rights":{"license":"CC0"},"editorial":{"note":"A lamp of this design was first featured in Siegfried Bing's 1899 display of Louis Comfort Tiffany's designs at the Grafton Galleries in London then in Tiffany's own stand at the 1900 Paris Exposition Universelle.","noteSource":"source","room":"interiors","tags":["19th-century","bronze","america","decorative-arts","leaded-glass","metalwork"],"tone":"sky","quality":1.29},"media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1997.298/1997.298_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2365":{"n":2365,"cl":1,"id":"cma-291887","type":"image","cat":"visual","title":"Cake Basket","creator":"Samuel Herbert and Company","date":"1753","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/2016.302"},"rights":{"license":"CC0"},"editorial":{"note":"Sheaves of wheat adorning the rim of this basket allude to the flour used in pastries and cakes for tea.","noteSource":"source","room":"interiors","tags":["18th-century","silver","decorative-arts","london","britain"],"tone":"mauve",
land Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1964.271"},"rights":{"license":"CC0"},"editorial":{"note":"Nabeshima dishes were produced in standard sizes of three, five, and seven sun (a traditional measurement of around 3 cm) in diameter.","noteSource":"source","room":"interiors","tags":["17th-century","japan","ceramic","edo-period-1615-1868","japanese-art","nabeshima-type"],"tone":"sky","quality":1.25},"sw":"#363636","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1964.271/1964.271_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2727":{"n":2727,"cl":102,"id":"cma-149955","type":"image","cat":"visual","title":"Vase (Meiping) with Waves","creator":"Unknown maker","date":"1200s–1300s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1980.186"},"rights":{"license":"CC0"},"editorial":{"note":"When Jizhou ware is fired, the slip coating and the inlaid decoration assume a soft ivory color while the exposed clay body displays a warm cinnamon brown.","noteSource":"source","room":"interiors","tags":["13th-century","ceramic","china","jiangxi-province","jizhou-ware","yonghezhen"],"tone":"paper","quality":1.25},"sw":"#717478","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1980.186/1980.186_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2734":{"n":2734,"cl":102,"id":"cma-155060","type":"image","cat":"visual","title":"Prince Shōtoku at Age Two (Shōtoku Taishi)","creator":"Unknown maker","date":"early 1300s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1989.76"},"rights":{"license":"CC0"},"editorial":{"note":"Shōtoku Taishi had several titles. One translates to \"the prince of the stable door\" because he was said to have been born in the imperial stables.","noteSource":"source","room":"interiors","tags":["14th-century","japan","sculpture","color","japanese-art","wood-with-lacquer"],"tone":"sky","quality":1.25},"sw":"#888888","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1989.76/1989.76_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2755":{"n":2755,"cl":102,"id":"cma-140301","type":"image","cat":"visual","title":"Large Jar with Peonies, Orchids, and Chrysanthemums","creator":"Unknown maker","date":"late 1600s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1964.266"},"rights":{"license":"CC0"},"editorial":{"note":"This design shows the changing of the seasons: one side depicts a peony blossom in the spring, and the other side continues with chrysanthemums and an orchid in the autumn.","noteSource":"source","room":"interiors","tags":["17th-century","japan","ceramic","edo-period-1615-1868","japanese-art"],"tone":"sky","quality":1.25},"sw":"#7a7772","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1964.266/1964.266_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2781":{"n":2781,"cl":102,"id":"cma-153142","type":"image","cat":"visual","title":"Jar","creator":"Unknown maker","date":"1200s–1300s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1986.14"},"rights":{"license":"CC0"},"editorial":{"note":"To create leaf imprints in Jizhou ware, artisans dipped real leaves in glaze and placed them on vessels, where the leaves would then burn away while firing in the kiln.","noteSource":"source","room":"interiors","tags":["13th-century","ceramic","china","jiangxi-province","jizhou-ware","jizhou-kilns"],"tone":"paper","quality":1.25},"sw":"#747579","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1986.14/1986.14_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"2806":{"n":2806,"cl":102,"id
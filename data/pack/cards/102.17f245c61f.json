 Open Access","work":null,"url":"https://clevelandart.org/art/1980.185.a"},"rights":{"license":"CC0"},"editorial":{"note":"The kilns of Jingdezhen in Jiangxi province produced an extremely delicate porcelain made from the local resources of kaolin (white China clay) and petuntse (a feldspathic rock called china stone).","noteSource":"source","room":"interiors","tags":["12th-century","ceramic","china","jiangxi-province","jingdezhen","qingbai-blue-white-ware"],"tone":"sky","quality":1.25},"sw":"#8b8b8b","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1980.185.a/1980.185.a_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"3172":{"n":3172,"cl":102,"id":"cma-149954","type":"image","cat":"visual","title":"Cup and Stand (stand)","creator":"Unknown maker","date":"1100s","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1980.185.b"},"rights":{"license":"CC0"},"editorial":{"note":"The kilns of Jingdezhen in Jiangxi province produced an extremely delicate porcelain made from the local resources of kaolin (white China clay) and petuntse (a feldspathic rock called china stone).","noteSource":"source","room":"interiors","tags":["12th-century","ceramic","china","glazed-porcelain"],"tone":"sky","quality":1.25},"sw":"#8a8a8a","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1980.185.b/1980.185.b_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"3185":{"n":3185,"cl":102,"id":"cma-140167","type":"image","cat":"visual","title":"Brush Washer with Dragons","creator":"Unknown maker","date":"1426–35","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1964.166"},"rights":{"license":"CC0"},"editorial":{"note":"The attractive tonal range found in the painted decoration, resulting from the irregular size of cobalt bits in the pigment, and the pocked glaze surface iden
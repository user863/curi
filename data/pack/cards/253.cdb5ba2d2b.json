ieval","indian-art","ivory","northern-india","kashmir","8th-century"],"tone":"paper","quality":1.25},"sw":"#4c4c4d","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1971.18/1971.18_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"3184":{"n":3184,"cl":253,"id":"cma-128356","type":"image","cat":"visual","title":"Pedestal Bowl","creator":"Unknown maker","date":"c. 900–1519","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1951.317"},"rights":{"license":"CC0"},"editorial":{"note":"The nobility may have used these goblets for a chocolate beverage or for pulque, made from the fermented sap of the maguey cactus.","noteSource":"source","room":"interiors","tags":["medieval","ceramic","aa-mesoamerica","mexico","cholula","mixteca-puebla-style"],"tone":"sky","quality":1.25},"sw":"#676766","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1951.317/1951.317_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"3186":{"n":3186,"cl":253,"id":"cma-143176","type":"image","cat":"visual","title":"Elongated Mask Ornament","creator":"Unknown maker","date":"c. 900–300 BCE","source":{"institution":"Cleveland Museum of Art, Open Access","work":null,"url":"https://clevelandart.org/art/1967.154"},"rights":{"license":"CC0"},"editorial":{"note":"Small masks made of precious media-especially greenstone, which Mesoamerican people valued above most other materials-likely served as elements of Olmec elite regalia.","noteSource":"source","room":"interiors","tags":["ancient","sculpture","aa-mesoamerica","mexico","mesoamerica","greenstone"],"tone":"mauve","quality":1.25},"sw":"#5b5d5c","media":{"kind":"image","url":"https://openaccess-cdn.clevelandart.org/1967.154/1967.154_web.jpg","fallback":null,"poster":null,"start":null,"end":null,"duration":null}},"3193":{"n":3193,"cl":253,"id":"cma-124396","type":"image","cat":"visual","title":"Pers
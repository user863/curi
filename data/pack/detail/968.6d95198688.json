unknown","verifiedBy":"unknown","attribution":"Obiect cu semnificație și profundă simbolistică rituală, funerară, folosit și pe stâlpii de mormânt ai tinerilor feciori. Larg răspândit în trecut pe Valea Sebeșului Obiectul are o formă de fus turtit central cu aripi, coadă și cap. Obiectul este vopsit în albastru deschis iar ochi roșii sunt adânciți prin scobire. Pe partea inferioară se identifică un orificiu de fixare pe stâlpul funerar. Cromatică: albăstriu; colorant chimic by unknown, CC BY-SA (https://www.europeana.eu/item/951/Culturalia_0c10f106_dd40_4584_8dab_755d26f0a6bb); ASTRA National Museum Complex via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null},"colour":{"pal":[["bfc3c6",35],["cbced0",25],["b1b5b7",20],["6d8da0",14],["597788",6]],"tone":["muted"]}},"50872":{"source":{"collection":"art","sourceId":"/916106/vbg_object_VM15415_1","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"yes","verifiedBy":"unknown","attribution":"PORSLINSHUND by unknown, CC BY (https://www.europeana.eu/item/916106/vbg_object_VM15415_1); Vänersborgs museum via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null},"colour":{"pal":[["0d0d0e",37],["bebcbd",28],["a7a29d",22],["89827e",8],["494346",5]],"tone":["monochrome"]}},"50873":{"source":{"collection":"art","sourceId":"/916106/vbg_object_VM15415_2","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"yes","verifiedBy":"unknown","attribution":"PORSLINSHUND by unknown, CC BY (https://www.europeana.eu/item/916106/vbg_object_VM15415_2); Vänersborgs museum via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null},"colour":{"pal":[["161619",45],["d1d3d5",29]
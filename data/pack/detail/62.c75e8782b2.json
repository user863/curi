eUrl":"https://creativecommons.org/publicdomain/mark/1.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"44291":{"source":{"collection":"art","sourceId":"/2048047/Clasate_d27c56e30f4643f490a79eb9754ef261","fetchedAt":"2026-11-09"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"nodus de sobă by unknown, CC BY-SA (https://www.europeana.eu/item/2048047/Clasate_d27c56e30f4643f490a79eb9754ef261); ASTRA National Museum Complex via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"46868":{"source":{"collection":"art","sourceId":"/437/item_FNEW2KJTLZXS2ZI37LD2ACEGVUWSCYYW","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"yes","verifiedBy":"unknown","attribution":"Nanko Tempel by Lübeck, Oswald (Herstellung) (Fotograf), Public Domain Mark (https://www.europeana.eu/item/437/item_FNEW2KJTLZXS2ZI37LD2ACEGVUWSCYYW); Deutsche Fotothek via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"47363":{"source":{"collection":"art","sourceId":"/951/Culturalia_04383440_ba97_4e02_9459_e27c05427455","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"Recipient ceramic de dimensiuni reduse, de formă bitronconică, cu baza plată, pântecul pronunțat și buza evazată. Cana prezintă o toartă care pornește de la nivelul gâtului și se unește cu vasul la nivelul diametrului maxim al acestuia. Opus toartei a fost realizat prin impresiune cu degetul, ciocul de scurgere. Întreaga suprafață a vasului prezintă motive ornamentale. Pântecul pronunțat al vasul prezintă motive fitomorfe stilizate: frontal, peste stratul crem de angobă a fost pictată o floare albastră, mărginită de frunze verzi. Jumătatea superioară prezintă peste fondul maro închis decor simplu: șiruri de vopsea, realizate prin pictare cu pensula. Cana era folosită în gospodărie pentru manevrarea, păstrarea sau servirea lichidelor. Prezintă uzură funcțională. Cromatică: fond: crem; maro închis (exterior); maro închis (interior); motive: alb; verde; albastru, maro roșcat. by unknown, CC BY-SA (https://www.europeana.eu/item/951/Culturalia_04383440_ba97_4e02_9459_e27c05427455); ASTRA National Museum Complex via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"50831":{"source":{"collection":"art","sourceId":"/951/Culturalia_0b5423b4_ee20_4e42_bfc9_6de76117359d","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"Recipient tronconic cu buza foarte înaltă și ieșită înafară. Pe buză prezintă două toarte mici pentru manevrare. Vasul este smălțuit în interior și pe buză în exterior. Este decorat în interior cu o linie concentrică în zona în care buza iasă înafară și cu pete aleatorii pe pereți și pe fundul vasului. Cromatică: fond: gălbui; motive: ocru. by unknown, CC BY-SA (https://www.europeana.eu/item/951/Culturalia_0b5423b4_ee20_4e42_bfc9_6de76117359d); ASTRA National Museum Complex via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"52235":{"source":{"collection":"art","sourceId":"/437/item_KT2SFBNP7ZOEIBSKILZD2CORCEOSF4VH","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"Ra mit Panje by Schumacher, Klaus-Dieter (Herstellung) (Fotograf), CC BY-SA (https://www.europeana.eu/item/437/item_KT2SFBNP7ZOEIBSKILZD2CORCEOSF4VH); Deutsche Fotothek via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"52237":{"source":{"collection":"art","sourceId":"/437/item_KUARP3EUPQ2EEIQJGY73IKRCFX7LQNHS","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"Der Wein zwinget manchen oft mehr Stärke und Weisheit ein, als er kann und vermag by Ahlers, Henrik (Herstellung) (Fotograf), CC BY-SA (https://www.europeana.eu/item/437/item_KUARP3EUPQ2EEIQJGY73IKRCFX7LQNHS); Deutsche Fotothek via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}},"57620":{"source":{"collection":"art","sourceId":"/951/Culturalia_1bc9c238_d6db_4856_b78e_e93c9945f8dc","fetchedAt":"2026-11-10"},"rights":{"jurisdictions":"worldwide","derivativesOk":"unknown","verifiedBy":"unknown","attribution":"Vas din lut, smălțuit, de formă tronconică, cu buza rotunjită. Prevăzut cu două toarte care pleacă în unghi drept și se ondulează pe margini, având punctele din inserție în buză și în diametrul maxim al castronului. Acestea prezintă două orificii circulare, pentru o mai bună manipulare. Cromatică: cărămiziu. by unknown, CC BY-SA (https://www.europeana.eu/item/951/Culturalia_1bc9c238_d6db_4856_b78e_e93c9945f8dc); ASTRA National Museum Complex via Europeana","creditLine":null,"licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0/","gate":"yes"},"media":{"medium":null,"dimensions":null,"culture":null}}}